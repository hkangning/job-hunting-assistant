# 复制为 .env 后按需修改；.env 已被 gitignore，严禁提交
DEBUG=true
# MySQL 8.0 连接串（库需先手工创建，见数据库设计文档 §7；密码用真实值，本文件仅模板）
DATABASE_URL=mysql+pymysql://jobhunter:<密码>@127.0.0.1:3306/job_hunter?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173"]

# JWT 签名 + Fernet 加密主密钥（系统设计 3.5）
# 留空时服务首次启动会自动生成随机值并写回 .env；换掉本值会使全部已签发 Token 立即失效
APP_SECRET_KEY=

# AI 密钥环境变量兜底（设置页配置优先，见系统设计 5.4 Key 读取链）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=
