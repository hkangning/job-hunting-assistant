# 复制为 .env 后按需修改；.env 已被 gitignore，严禁提交
DEBUG=true
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=["http://localhost:5173"]

# JWT 签名 + Fernet 加密主密钥（系统设计 3.5）
# 留空时服务首次启动会自动生成随机值并写回 .env；换掉本值会使全部已签发 Token 立即失效
APP_SECRET_KEY=

# AI 密钥环境变量兜底（设置页配置优先，见系统设计 5.4 Key 读取链）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=
